{
  "mcpServers": {
    "time": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-time"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "get_current_time",
        "get_timezone"
      ]
    },
    "fetch": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-fetch"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "fetch_url",
        "fetch"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "read_file",
        "list_directory",
        "write_file",
        "read_multiple_files"
      ]
    },
    "git": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "git_status",
        "git_log",
        "git_diff"
      ]
    },
    "github": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": []
    },
    "postgres": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-postgres"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": []
    },
    "brave-search": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": []
    },
    "sqlite": {
      "command": "python",
      "args": [
        "-m",
        "uv",
        "tool",
        "run",
        "mcp-server-sqlite",
        "--db-path",
        "./data.db"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "query",
        "describe_table",
        "list_tables"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "create_entities",
        "create_relations",
        "search_nodes",
        "get_entities"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "create_thought",
        "update_thought",
        "get_thoughts",
        "sequentialthinking"
      ]
    }
  }
}