# Frontend Configuration
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Client Scoping Platform
VITE_APP_VERSION=1.0.0

# Environment
NODE_ENV=development

# API Configuration
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Database Configuration
VITE_MONGODB_URI=
VITE_FALLBACK_TO_MEMORY=true

# Logging Configuration
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGGING=true
VITE_ENABLE_REMOTE_LOGGING=false
VITE_REMOTE_LOG_ENDPOINT=

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_PERFORMANCE_SAMPLE_RATE=1.0
VITE_ENABLE_WEB_VITALS=true
VITE_ENABLE_MEMORY_MONITORING=true

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_ENABLE_RATE_LIMITING=true
VITE_MAX_REQUESTS_PER_MINUTE=100

# Core Feature Flags
VITE_ENABLE_BUDGET_TIER_SELECTOR=true
VITE_ENABLE_CONDITIONAL_QUESTIONS=true
VITE_ENABLE_FORM_VALIDATION=true
VITE_ENABLE_AUTO_SAVE=true

# Development Feature Flags
VITE_ENABLE_TEST_DATA_GENERATOR=true
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_TESTING_UTILITIES=true

# Analytics and Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_USER_TRACKING=false

# UI/UX Feature Flags
VITE_ENABLE_PROGRESS_ANIMATION=true
VITE_ENABLE_HELPFUL_HINTS=true
VITE_ENABLE_FORM_WIZARD_NAVIGATION=true

# Admin Feature Flags
VITE_ENABLE_ADMIN_DASHBOARD=true
VITE_ENABLE_SUBMISSION_EXPORT=true
VITE_ENABLE_BULK_OPERATIONS=false

# Build Information
VITE_BUILD_DATE=
VITE_GIT_COMMIT=
VITE_GIT_BRANCH=